# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any .env files with real secrets to version control

# ========================================
# Security Configuration
# ========================================
# CSP Nonce for inline scripts (automatically generated in production)
# NEXT_PUBLIC_CSP_NONCE=

# ========================================
# Analytics & Monitoring (Optional)
# ========================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=

# ========================================
# Third-Party Services (Optional)
# ========================================
# Add any third-party API keys here if needed
# Always use environment variables for secrets, never hardcode them

# ========================================
# Development vs Production
# ========================================
# NODE_ENV=development (set automatically by Next.js)

# ========================================
# Security Best Practices
# ========================================
# 1. Never commit actual .env files with secrets
# 2. Use different values for development and production
# 3. Rotate secrets regularly
# 4. Limit permissions of API keys
# 5. Use secrets management services in production (e.g., Vercel Environment Variables)
# 6. Keep dependencies updated with pnpm audit
